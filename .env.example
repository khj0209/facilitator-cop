# Facilitator's own gas-paying key (keep it separate from the token deployer/owner key).
# Generate with `cast wallet new` and fund the address with a little Sepolia ETH.
# Without it, /verify works but /settle refuses to submit transactions.
FACILITATOR_PRIVATE_KEY=0x...
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Defaults to the DemoCoin deployment in coin-contract/README.md
# ETHEREUM_ASSET_ADDRESS=
# PORT=4001
